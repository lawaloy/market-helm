# Copy to .env.staging on the host. Never commit the populated file.
MARKETHELM_AUTH_SECRET=replace-with-at-least-32-random-characters
MARKETHELM_PUBLIC_URL=https://staging.example.com
MARKETHELM_REQUIRE_EMAIL_VERIFICATION=true
CORS_ORIGINS=https://staging.example.com
MARKETHELM_TRUSTED_PROXY_CIDRS=127.0.0.1/32
FINNHUB_API_KEY=
ALERT_EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=accounts@staging.example.com
ALERT_CHECK_INTERVAL_SECONDS=60
MARKETHELM_RATE_LIMIT_AUTH_EMAIL=5
