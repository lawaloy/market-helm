{
  "name": "markethelm-web-eslint",
  "version": "0.0.0",
  "private": true,
  "description": "ESLint tooling for dashboard/frontend. Separate package because typescript-eslint does not support TypeScript 7 yet.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "lint": "cd ../.. && node tools/eslint/node_modules/eslint/bin/eslint.js --max-warnings 0 -c tools/eslint/eslint.config.js src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
